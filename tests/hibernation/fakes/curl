#!/usr/bin/env python3
"""Test double for curl: serves the Composer imageVersions REST API from
$FAKE_GCP_DIR/image-versions.json. Requires the bearer token to arrive via a
curl config on stdin (-K -), as scripts/hibernation sends it."""
import json, os, re, sys

world = os.environ["FAKE_GCP_DIR"]
args = sys.argv[1:]
with open(os.path.join(world, "curl-calls.log"), "a") as f:
    f.write(json.dumps(args) + "\n")
url = next((a for a in args if a.startswith("http")), "")
config = sys.stdin.read() if "-K" in args else ""
if 'header = "Authorization: Bearer fake-access-token"' not in config:
    sys.stderr.write("curl: (22) The requested URL returned error: 401\n")
    sys.exit(22)
faults = os.path.join(world, "curl-fail")
if os.path.exists(faults):
    sys.stderr.write("curl: (22) The requested URL returned error: 503\n")
    sys.exit(22)
m = re.search(r"/v1/projects/([^/]+)/locations/([^/]+)/imageVersions", url)
if not m:
    sys.stderr.write("curl: (22) The requested URL returned error: 404\n")
    sys.exit(22)
versions = json.load(open(os.path.join(world, "image-versions.json")))
# Two pages, to exercise pagination.
token = re.search(r"pageToken=([^&]+)", url)
half = len(versions) // 2
if token:
    body = {"imageVersions": versions[half:]}
else:
    body = {"imageVersions": versions[:half], "nextPageToken": "page-2"}
sys.stdout.write(json.dumps(body))
